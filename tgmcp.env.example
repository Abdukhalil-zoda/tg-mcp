# TgMcp access policy. Everything is denied unless allowed here.
# Any unknown TGMCP_ key, wrong type or bad value => the server starts but DENIES EVERYTHING.
# Check it without contacting Telegram:  docker run --rm --env-file tgmcp.env tgmcp:<tag> config check
# Note: --env-file takes values literally; do not quote them.

# Master switch.
TGMCP_Enabled=true

# Global switches. A feature works only if it is on here AND in the chat's rule.
TGMCP_Features__Read=true
TGMCP_Features__Search=true
TGMCP_Features__MediaDownload=false

# Defaults for chats that match no rule.
TGMCP_Defaults__Read=false
TGMCP_Defaults__Write=off
TGMCP_Defaults__Features=

# Rule 0: a work group. Read the last 14 days, allow search.
TGMCP_Chats__0__Id=-1001234567890
TGMCP_Chats__0__Read=true
TGMCP_Chats__0__Features=search
TGMCP_Chats__0__SinceDays=14

# Rule 1: a public channel by username, read only.
TGMCP_Chats__1__Username=example_channel
TGMCP_Chats__1__Read=true

# Rule 2: a forum supergroup, only topics 1 and 42.
TGMCP_Chats__2__Id=-1009876543210
TGMCP_Chats__2__Read=true
TGMCP_Chats__2__Topics=1,42

# Hard denies (always win over any rule).
TGMCP_Deny__0__Type=bot
# Telegram service notifications (login codes!).
TGMCP_Deny__1__Id=777000
# Everything in a chat folder named "Finance".
TGMCP_Deny__2__Folder=Finance

# Limits.
TGMCP_Limits__ListChats=allowed_only
TGMCP_Limits__MaxMessagesPerCall=200
TGMCP_Limits__RatePerMinute=30
TGMCP_Limits__MaxMediaMb=50
