# TgMcp environment file: SECRETS (required) and optional overrides.
# Copy to e.g. /etc/tgmcp/tgmcp.env, `chmod 600`, and pass it with --env-file. NEVER commit the real file.
# The access policy itself lives in the JSON file (see tgmcp.example.jsonc).
# Note: --env-file takes values literally; do not quote them.

# --- Secrets (environment only; refused in the JSON file) -------------------------------------------
# api_id / api_hash: create an application at https://my.telegram.org -> API development tools.
TGMCP_ApiId=0
TGMCP_ApiHash=replace-with-your-api-hash
# Encryption key for the local TDLib database (any long random string, e.g. `openssl rand -hex 32`).
# Alternatively mount a file and set TGMCP_DatabaseKeyFile=/run/secrets/tgmcp_db_key instead.
TGMCP_DatabaseKey=replace-with-a-long-random-string

# --- Optional runtime settings ----------------------------------------------------------------------
# TGMCP_ConfigFile=/config/tgmcp.json   # policy file path (default /config/tgmcp.json)
# TGMCP_DataDir=/data                   # TDLib database, files, audit log
# TGMCP_AuditPath=/data/audit.jsonl

# --- Phone numbers that send_message may reach by "phone" (environment only) ------------------------
# Only used when "contacts.mode" is "draft" or "on". E.164, comma-separated. Never put these in tgmcp.json.
# TGMCP_ContactsAllow=+15551234567,+447700900123

# --- Optional policy overrides (win over the JSON file) ---------------------------------------------
# Same keys as the JSON file, with "__" for nesting and N for list positions, e.g.:
# TGMCP_Enabled=false                   # emergency off switch without editing the file
# TGMCP_Limits__RatePerMinute=10
# TGMCP_Chats__0__Read=false            # overrides "read" of the first rule in "chats"
