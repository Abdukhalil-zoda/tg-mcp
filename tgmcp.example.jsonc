// =====================================================================================================
//  TgMcp access policy (template)
// =====================================================================================================
//
//  This file decides what an AI assistant may do with YOUR Telegram account through TgMcp.
//  Everything is DENIED unless this file (or a TGMCP_* environment override) allows it.
//
//  Where the file lives
//    Inside the container TgMcp reads /config/tgmcp.json (change with the env var TGMCP_ConfigFile).
//    Mount it read-only from the host, e.g.  -v /etc/tgmcp/tgmcp.json:/config/tgmcp.json:ro
//    The container runs as uid 1654, so the host file must be readable by it:
//        chown root:1654 /etc/tgmcp/tgmcp.json && chmod 0640 /etc/tgmcp/tgmcp.json
//
//  Format
//    JSON with // and /* */ comments and trailing commas allowed. Keys are case-insensitive.
//    Strict: an unknown key, a wrong type or a bad value makes the WHOLE config invalid, and then the
//    server still starts but denies EVERYTHING (the reason is printed to stderr and the audit log).
//
//  Precedence
//    built-in defaults  <  this file  <  TGMCP_* environment variables
//    (e.g. TGMCP_Limits__RatePerMinute=10 overrides "limits.ratePerMinute"; see tgmcp.env.example).
//
//  Secrets NEVER go in this file. api_id, api_hash and the database key are environment-only
//  (TGMCP_ApiId, TGMCP_ApiHash, TGMCP_DatabaseKey); putting them here makes the config invalid.
//
//  How every call is decided (in this order)
//    1. "enabled"                 master switch; false = deny everything
//    2. "features"                global switch for the capability (read, search, ...)
//    3. "deny"                    if ANY deny rule matches the chat -> denied, no exceptions
//    4. "chats"                   the FIRST rule whose selector matches the chat is used ...
//    5. "defaults"                ... or the defaults if no rule matches; keys a rule leaves out also
//                                 come from the defaults
//    6. "limits"                  per-call message cap, rate limit, media size
//    A feature works only if it is on in "features" AND in the chat's rule (or the defaults).
//
//  How to apply changes
//    1. Edit this file.
//    2. Check it (does not contact Telegram; exit code 1 if invalid):
//         docker run --rm -v /etc/tgmcp/tgmcp.json:/config/tgmcp.json:ro tgmcp:<tag> config check
//    3. Restart / reconnect the MCP server (in Claude Code: /mcp -> reconnect "tg"). The policy is
//       read once at start; its sha256 is written to the audit log.
//
//  How to find a chat id
//    - Ask the assistant to read the chat: the denial message contains the id and a ready-to-paste rule.
//    - Telegram Web (web.telegram.org/a/): open the chat; the URL ends with #<id>, e.g. #-1001234567890.
//    - A message link https://t.me/c/1234567890/42 belongs to the chat -1001234567890
//      (put -100 in front of the number after /c/). This works for supergroups and channels.
//    - Public chats can simply be selected by "username" instead of "id".
// =====================================================================================================
{
  // Master switch. false (the default) denies everything.
  "enabled": true,

  // Global switches. Each defaults to false. A capability must be on here AND in the chat's rule.
  "features": {
    "read": true,           // read messages (read_messages, read_topic, get_message, list_chats details)
    "search": true,         // search_chat, search_all
    "mediaDownload": false, // download_media
    "send": false,          // send_message: writing AS YOU, as drafts or directly (see "write" per chat)
    "join": false,          // join_chat / preview_chat: joining groups/channels AS YOU (see "join" below)
    // Reserved for later versions (accepted and validated, currently without effect):
    "summarize": false,
    "translate": false,
    "react": false,
    "markRead": false,
    "editOwn": false,
    "deleteOwn": false,
    "forward": false,
    "pin": false,
  },

  // Used for chats that match no rule in "chats", and for keys a rule leaves out.
  "defaults": {
    "read": false,          // true = every chat not denied becomes readable (not recommended)
    "write": "off",         // "off" | "draft" (you approve each message: `tgmcp approve <id>`) | "on" (sent at once)
    "features": [],         // per-chat features: "search", "media_download" (+ reserved: "summarize",
                            // "translate", "react", "mark_read", "edit_own", "delete_own", "forward", "pin")
    "sinceDays": null,      // hide messages older than N days; null = no limit
    "notify": false,        // push new messages as events (see "events"); needs "read": true.
                            // Never applies to bot/channel chats or bot senders: those need an explicit rule.
  },

  // Allow rules. The FIRST matching rule wins, so put specific rules before general ones.
  // Each rule has EXACTLY ONE selector:
  //   "id"        chat id (number; supergroups/channels start with -100)
  //   "username"  public username, '@' optional, case-insensitive
  //   "title"     exact chat title (fragile: anyone with rights can rename a group)
  // Optional "name" / "note": free text for humans and `config check`; never used for matching.
  // Permission keys (all optional, missing = taken from "defaults"):
  //   "read" (bool), "write" ("off"|"draft"|"on"), "features" (list), "sinceDays" (number >= 1),
  //   "topics" (list of forum topic ids; empty or missing = all topics; also limits where messages may be sent)
  //   "notify" (bool): new messages in this chat are pushed to the assistant as events (needs "read": true
  //                    and "events.enabled": true)
  // "write" needs "features.send": true. Messages are sent from YOUR account; "draft" is the safe choice:
  // the assistant only saves a draft and you send it yourself with `tgmcp approve <id>` (or `tgmcp reject <id>`).
  // An empty list is valid:  "chats": []  (then only "defaults" apply).
  "chats": [
    // Read-only access to one group by id.
    { "id": -1001234567890, "name": "Work group", "read": true, "notify": true },

    // A public channel by username, with search.
    { "username": "example_channel", "name": "Example channel", "read": true, "features": ["search"] },

    // A forum supergroup: only topics 1 (General) and 42.
    { "id": -1009876543210, "name": "Community forum", "read": true, "topics": [1, 42] },

    // A private chat: only the last 30 days, with search and media download.
    // (media download also needs "features.mediaDownload": true above)
    { "username": "example_friend", "name": "Friend", "read": true, "features": ["search", "media_download"], "sinceDays": 30 },

    // The assistant may propose messages here; nothing is sent until you run `tgmcp approve <id>`.
    // (needs "features.send": true above)
    { "id": -1001111111111, "name": "Team chat (drafts)", "read": true, "write": "draft" },
  ],

  // Hard blocks. ALWAYS win over "chats" and "defaults". Exactly one selector per rule:
  //   "id" | "username" | "type" ("private" | "group" | "channel" | "bot") | "folder" (chat folder title)
  // A denied chat is never shown, and the assistant only ever sees "denied by policy" for it.
  // An empty list is valid:  "deny": []  (nothing is hard-blocked; not recommended).
  "deny": [
    { "type": "bot", "name": "All bots (banks, services with login codes)" },
    { "id": 777000, "name": "Telegram service notifications (login codes!)" },
    // Every chat in the chat folder named "Personal". If the folder can't be found, EVERYTHING is denied.
    { "folder": "Personal" },
  ],

  "limits": {
    "listChats": "allowed_only", // "allowed_only" (readable chats only) | "names_all" (names of all non-denied chats) | "off"
    "maxMessagesPerCall": 200,   // messages returned per call, >= 1
    "ratePerMinute": 30,         // tool calls per minute for the whole server, >= 1
    "maxMediaMb": 50,            // largest file download_media will fetch, >= 1
    "sendsPerMinute": 10,        // send_message calls (sent or drafted) per chat per minute, >= 1
    "joinsPerHour": 5,           // join_chat calls (joined or drafted) per hour, >= 1
    "mediaRetentionDays": 7,     // delete downloaded media older than N days; 0 = keep forever
  },

  // Joining groups/channels (needs "features.join": true). Messages in other chats may try to make the assistant
  // join spam or phishing groups, so the default is "off" and "draft" is recommended.
  //   "off"   join_chat is denied
  //   "draft" nothing is joined; a join draft waits for `tgmcp approve <id>` (or `tgmcp reject <id>`)
  //   "on"    joins immediately, but ONLY targets listed in "allow" (empty list = nothing)
  // "allow" entries: "@example_channel", "example_channel", "t.me/example_channel", "+InviteHash"
  //   (from https://t.me/+InviteHash), or "*" for anything (DANGEROUS: any link in any message could be joined).
  // Joining never grants read/write: the joined chat falls under "defaults" until you add a rule for it
  // (the join_chat result shows the exact rule).
  "join": {
    "mode": "off",
    "allow": [],
  },

  // Inbound events: new messages from chats with "notify": true are pushed into the assistant's session
  // (MCP channel notifications) instead of being polled. Message content is untrusted third-party data.
  // When enabled, the server starts Telegram at startup and keeps the database open (one process per data dir).
  "events": {
    "enabled": false,         // master switch for events
    "includeOutgoing": false, // also push your own messages
    "maxPerMinute": 30,       // more are dropped, with one "N more messages dropped" summary per minute
    "maxTextChars": 4000,     // longer texts are truncated
    "catchUpMinutes": 0,      // on start, replay messages missed in the last N minutes (max 50); 0 = off
  },

  // Where download_media puts files (inside the container). Optional.
  "media": {
    // "dir": "/media",                  // default: /data/media (inside the data volume)
    // "hostDir": "/var/lib/tgmcp/media" // host path of "dir" if you bind-mount it; reported as host_path
  },
}
