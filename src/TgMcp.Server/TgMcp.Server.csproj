<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tgmcp</AssemblyName>
    <RootNamespace>TgMcp.Server</RootNamespace>
    <Description>TgMcp composition root: MCP stdio server and owner CLI (serve, login, config check).</Description>
    <!-- linux-x64 by default; the Dockerfile publishes linux-arm64 for arm64 images. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TgMcp.Application\TgMcp.Application.csproj" />
    <ProjectReference Include="..\TgMcp.Infrastructure.Telegram\TgMcp.Infrastructure.Telegram.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>
</Project>
